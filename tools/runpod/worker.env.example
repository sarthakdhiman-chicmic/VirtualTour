# The tour worker's settings on a RunPod GPU pod. Copy to <repo>/worker.env (gitignored: it
# holds keys) and fill in. tools/runpod/env.sh and start.sh read it.

# the key the backend sends (Authorization: Bearer ...): the backend's TOUR_RENDER_WORKER_KEY,
# or RUNPOD_API_KEY when it calls through RUNPOD_ENDPOINT_URL
WORKER_API_KEY=

# S3: read the photos / scenes, write the videos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

HOST=0.0.0.0
PORT=8000
# when the backend calls RUNPOD_ENDPOINT_URL + RUNPOD_TOUR_RENDER_PATH / RUNPOD_TOUR_SEGMENT_PATH
SERVICE_PREFIXES=/tour/render,/tour/segment

# 3D tours (plan 1.6)
SPLAT_BACKEND=gsplat
SPLAT_SUPERSAMPLE=1.5
SPLAT_SH_DEGREE=3

# Scene files are NOT kept on disk: each job downloads its scene into its own temp folder and
# deletes it once loaded (the last scene stays in memory, so a repeat render does not re-download).
# Set SCENE_CACHE_DIR only to keep them on disk by sha256.
# SCENE_CACHE_DIR=
# Segmentation weights and the service's records: by default under <repo>/.pod/ (models, run).
# MODELS_DIR=
# JOBS_DIR=
