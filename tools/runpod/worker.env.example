# The tour worker's settings on a RunPod GPU pod. Copy to ~/.config/tour-worker/worker.env
# (outside the repo: it holds keys) and fill in. tools/runpod/start.sh reads it.

# the key the backend sends (Authorization: Bearer ...): the backend's TOUR_RENDER_WORKER_KEY,
# or RUNPOD_API_KEY when it calls through RUNPOD_ENDPOINT_URL
WORKER_API_KEY=

# S3: read the photos / scenes, write the videos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

HOST=0.0.0.0
PORT=8000
# when the backend calls RUNPOD_ENDPOINT_URL + RUNPOD_TOUR_RENDER_PATH / RUNPOD_TOUR_SEGMENT_PATH
SERVICE_PREFIXES=/tour/render,/tour/segment

# 3D tours (plan 1.6)
SPLAT_BACKEND=gsplat
SPLAT_SUPERSAMPLE=1.5
SPLAT_SH_DEGREE=3
# scene files by sha256, fetched once; put it on the pod's volume so it survives restarts
SCENE_CACHE_DIR=/workspace/tour-worker/scenes

# segmentation weights (tour_segment); on the volume as well
MODELS_DIR=/workspace/tour-worker/models
